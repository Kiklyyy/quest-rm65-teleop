<?xml version="1.0"?>
<package format="3">
  <name>rm65_teleop_adapter</name>
  <version>0.2.0</version>
  <description>Safety-gated Quest right-hand to RealMan RM65 Cartesian adapter.</description>
  <maintainer email="lh@todo.todo">B side maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <depend>control_msgs</depend><depend>sensor_msgs</depend><depend>trajectory_msgs</depend><depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend><depend>quest2ros</depend><depend>rclcpp</depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>q2r2_bringup</exec_depend><exec_depend>rclpy</exec_depend>
  <exec_depend>ros_tcp_endpoint</exec_depend><exec_depend>rviz2</exec_depend>
  <depend>rm_ros_interfaces</depend><depend>std_msgs</depend><depend>std_srvs</depend>
  <test_depend>ament_cmake_gtest</test_depend><test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export><build_type>ament_cmake</build_type></export>
